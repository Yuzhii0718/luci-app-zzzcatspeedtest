{
	"luci-app-zzzcatspeedtest": {
		"description": "Grant access to LuCI app zzzcatspeedtest",
		"read": {
			"ubus": {
				"luci": ["getInitList"]
			},
			"uci": ["zzzcatspeedtest"],
			"file": [
				"/usr/share/zzzcatspeedtest/speedtest-go",
				"/usr/share/zzzcatspeedtest/buildinfo.json"
			]
		},
		"write": {
			"ubus": {
				"luci": ["setInitAction"]
			},
			"uci": ["zzzcatspeedtest"],
			"file": [
				"/etc/init.d/zzzcatspeedtest",
				"/bin/busybox"
			]
		}
	}
}
